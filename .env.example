# Supabase and Resend example env vars
# Copy to .env.local and populate with your real values (never commit secrets)

# Supabase (already used by the project)
# NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend API Key (used by server to send emails)
RESEND_API_KEY=key_live_XXXXXXXXXXXXX

# Optional: Change FROM address if needed (must be a verified domain in Resend)
# EMAIL_FROM=Pixel Ceylon <noreply@pixelceylon.com.au>
